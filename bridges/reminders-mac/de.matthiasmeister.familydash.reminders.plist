<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install:
    mkdir -p ~/.local/bin && cp familydash-reminders ~/.local/bin/
    cp de.matthiasmeister.familydash.reminders.plist ~/Library/LaunchAgents/
    (edit paths + token below, replace YOURUSER)
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/de.matthiasmeister.familydash.reminders.plist
  Logs: /tmp/familydash-reminders.log
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>de.matthiasmeister.familydash.reminders</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOURUSER/.local/bin/familydash-reminders</string>
		<string>--watch</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DASH_URL</key>
		<string>http://192.168.188.127:8080/api/reminders</string>
		<key>DASH_TOKEN</key>
		<string>CHANGE-ME</string>
		<key>DASH_LISTS</key>
		<string></string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>/tmp/familydash-reminders.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/familydash-reminders.log</string>
</dict>
</plist>
