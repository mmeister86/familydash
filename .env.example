# Copy to .env and fill in. All settings are plain environment variables,
# the Unraid template exposes the same ones.

TZ=Europe/Berlin

# Google Calendar → Einstellungen → [Kalender] → "Privatadresse im iCal-Format"
CALENDAR_1_NAME=Familie
CALENDAR_1_URL=https://calendar.google.com/calendar/ical/.../private-.../basic.ics
CALENDAR_1_COLOR=#4F8EF7
# CALENDAR_2_NAME=Dienst
# CALENDAR_2_URL=
# CALENDAR_2_COLOR=#A77BF3
# A school calendar shown as a card next to beste.schule instead of a column:
# CALENDAR_4_NAME=Hannah
# CALENDAR_4_URL=
# CALENDAR_4_COLOR=#F2B53A
# CALENDAR_4_PANEL=school
# Shown inside calendar 1's column instead of its own (keeps its own color):
# CALENDAR_5_NAME=Feiertage
# CALENDAR_5_URL=https://www.feiertage-deutschland.de/kalender-download/ics/feiertage-deutschland.ics
# CALENDAR_5_COLOR=#F76C5E
# CALENDAR_5_COLUMN=1
# … up to CALENDAR_20_*

CALENDAR_DAYS=7
CALENDAR_REFRESH=5m

# Weather (Open-Meteo, no key). Crimmitschau:
WEATHER_NAME=Crimmitschau
WEATHER_LAT=50.815
WEATHER_LON=12.388
WEATHER_REFRESH=15m

# beste.schule → user menu → API → Personal Access Token
BESTESCHULE_TOKEN=
# optional: only these children (first names or ids, comma-separated)
# BESTESCHULE_STUDENTS=Lukas
# optional: fix lessons with a wrong A/B week in beste.schule (Tag:Fach=Woche)
# BESTESCHULE_WEEK_FIX=Fr:PH=A

# Waste collection (Landratsamt Zwickau, Crimmitschau). WEEKS: gerade/ungerade/jede
WASTE_1_NAME=Restabfall
WASTE_1_DAY=Mi
WASTE_1_WEEKS=gerade
WASTE_2_NAME=Gelbe Tonne
WASTE_2_DAY=Do
WASTE_2_WEEKS=gerade
WASTE_3_NAME=Blaue Tonne
WASTE_3_DAY=Do
WASTE_3_WEEKS=ungerade
# WASTE_HOLIDAY_SHIFT=off

# Fixed timetable for a child without beste.schule (built into the image,
# internal/timetable/stundenplan.json). Own file or "off":
# TIMETABLE_FILE=/config/stundenplan.json

# Bring! (unofficial API, needs an e-mail/password login)
BRING_EMAIL=
BRING_PASSWORD=
# optional: list name, otherwise the account's default list
# BRING_LIST=Zuhause

# VielfaltMenü school lunch (unofficial, same login as bestellung.vielfaltmenue.com).
# One account per child: Kundennummer + password. Shows what is ordered today/tomorrow.
# VIELFALT_1_NAME=Lukas
# VIELFALT_1_USER=
# VIELFALT_1_PASSWORD=
# VIELFALT_1_COLOR=#4F8EF7
# VIELFALT_2_NAME=Hannah
# VIELFALT_2_USER=
# VIELFALT_2_PASSWORD=
# VIELFALT_2_COLOR=#F2B53A
# VIELFALT_REFRESH=30m

# Time-of-day layouts. School days (Mon–Fri); "off" skips a scene.
# SCENE_MORNING=06:00
# SCENE_DAY=08:00
# SCENE_AFTERNOON=15:00
# SCENE_EVENING=18:00
# SCENE_NIGHT=21:30
# Weekend overrides (others fall back to the school-day time):
# SCENE_MORNING_WEEKEND=07:30
# SCENE_DAY_WEEKEND=10:00
# Testing: always show one scene (or open the page with ?scene=evening)
# SCENE_FORCE=evening

# Photo slideshow. Default folder inside the container; mount
# /mnt/user/appdata/familydash to /data and use …/familydash/pictures on Unraid.
# PHOTOS_DIR=/data/pictures
# PHOTOS_INTERVAL=45s
# PHOTOS_SHUFFLE=on

# Things 3 (unofficial, via the bundled things3 CLI and your Things Cloud login).
# Shows the Today to-dos of one area. Cache: THINGS_STATE_DIR (default /data/things).
# THINGS_EMAIL=
# THINGS_PASSWORD=
# THINGS_AREA=Familie
# THINGS_REFRESH=5m

# Uptime Kuma status page in the footer (public JSON, no login needed).
# UPTIME_URL=http://192.168.188.127:3001/status/dashboard
# optional: Kuma API key → TLS certificate expiry from /metrics
# UPTIME_API_KEY=
# UPTIME_CERT_WARN_DAYS=14
# UPTIME_REFRESH=1m
