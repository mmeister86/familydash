# Copy to .env and fill in. All settings are plain environment variables,
# the Unraid template exposes the same ones.

TZ=Europe/Berlin

# Google Calendar → Einstellungen → [Kalender] → "Privatadresse im iCal-Format"
CALENDAR_1_NAME=Familie
CALENDAR_1_URL=https://calendar.google.com/calendar/ical/.../private-.../basic.ics
CALENDAR_1_COLOR=#4F8EF7
# CALENDAR_2_NAME=Schule
# CALENDAR_2_URL=
# CALENDAR_2_COLOR=#46C28E
# … up to CALENDAR_20_*

CALENDAR_DAYS=7
CALENDAR_REFRESH=5m

# Weather (Open-Meteo, no key). Crimmitschau:
WEATHER_NAME=Crimmitschau
WEATHER_LAT=50.815
WEATHER_LON=12.388
WEATHER_REFRESH=15m

# Shared secret for POST /api/reminders — generate with: openssl rand -hex 24
REMINDERS_TOKEN=
REMINDERS_STALE_AFTER=2h
