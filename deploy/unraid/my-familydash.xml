<?xml version="1.0"?>
<!--
  Unraid template. Copy to /boot/config/plugins/dockerMan/templates-user/my-familydash.xml
  then: Docker → Add Container → Template: familydash
-->
<Container version="2">
  <Name>familydash</Name>
  <Repository>ghcr.io/mmeister86/familydash:latest</Repository>
  <Registry>https://github.com/mmeister86/familydash/pkgs/container/familydash</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>Leichtgewichtiges Familiendashboard fürs Wanddisplay: Google Kalender (iCal), Wetter (Open-Meteo), Stundenplan/Vertretungen/Hausaufgaben (beste.schule), Einkaufsliste (Bring!), Schulessen (VielfaltMenü), To-dos (Things 3), Dienst-Status (Uptime Kuma). Statische Binaries, ~20 MB Image.</Overview>
  <Category>Productivity: HomeAutomation:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <ExtraParams>--restart unless-stopped</ExtraParams>

  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Type="Port" Display="always" Required="true">8080</Config>

  <Config Name="Zeitzone" Target="TZ" Default="Europe/Berlin" Type="Variable" Display="always" Required="true">Europe/Berlin</Config>

  <Config Name="Kalender 1 – Name" Target="CALENDAR_1_NAME" Default="Familie" Type="Variable" Display="always" Required="false">Familie</Config>
  <Config Name="Kalender 1 – iCal-URL" Target="CALENDAR_1_URL" Default="" Description="Google Kalender → Einstellungen → Privatadresse im iCal-Format" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Kalender 1 – Farbe" Target="CALENDAR_1_COLOR" Default="#4F8EF7" Type="Variable" Display="advanced" Required="false">#4F8EF7</Config>
  <Config Name="Kalender 2 – Name" Target="CALENDAR_2_NAME" Default="" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Kalender 2 – iCal-URL" Target="CALENDAR_2_URL" Default="" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Kalender 2 – Farbe" Target="CALENDAR_2_COLOR" Default="#46C28E" Type="Variable" Display="advanced" Required="false">#46C28E</Config>
  <Config Name="Kalender 3 – Name" Target="CALENDAR_3_NAME" Default="" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Kalender 3 – iCal-URL" Target="CALENDAR_3_URL" Default="" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Kalender 3 – Farbe" Target="CALENDAR_3_COLOR" Default="#F2B53A" Type="Variable" Display="advanced" Required="false">#F2B53A</Config>
  <Config Name="Kalender 4 – Name" Target="CALENDAR_4_NAME" Default="" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Kalender 4 – iCal-URL" Target="CALENDAR_4_URL" Default="" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Kalender 4 – Farbe" Target="CALENDAR_4_COLOR" Default="#A77BF3" Type="Variable" Display="advanced" Required="false">#A77BF3</Config>
  <Config Name="Kalender 4 – Anzeige" Target="CALENDAR_4_PANEL" Default="column" Description="column = Spalte unten, school = Schulkarte oben" Type="Variable" Display="always" Required="false">column</Config>
  <Config Name="Kalender 5 – Name" Target="CALENDAR_5_NAME" Default="Feiertage" Type="Variable" Display="always" Required="false">Feiertage</Config>
  <Config Name="Kalender 5 – iCal-URL" Target="CALENDAR_5_URL" Default="" Description="z. B. https://www.feiertage-deutschland.de/kalender-download/ics/feiertage-deutschland.ics" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Kalender 5 – Farbe" Target="CALENDAR_5_COLOR" Default="#F76C5E" Type="Variable" Display="advanced" Required="false">#F76C5E</Config>
  <Config Name="Kalender 5 – in Spalte von" Target="CALENDAR_5_COLUMN" Default="1" Description="Nummer eines anderen Kalenders: Kalender 5 erscheint in dessen Spalte. Leer = eigene Spalte" Type="Variable" Display="always" Required="false">1</Config>
  <Config Name="Tage im Kalender" Target="CALENDAR_DAYS" Default="7" Type="Variable" Display="advanced" Required="false">7</Config>

  <Config Name="Wetter – Ortsname" Target="WEATHER_NAME" Default="Crimmitschau" Type="Variable" Display="always" Required="false">Crimmitschau</Config>
  <Config Name="Wetter – Breitengrad" Target="WEATHER_LAT" Default="50.815" Type="Variable" Display="always" Required="false">50.815</Config>
  <Config Name="Wetter – Längengrad" Target="WEATHER_LON" Default="12.388" Type="Variable" Display="always" Required="false">12.388</Config>

  <Config Name="beste.schule – Token" Target="BESTESCHULE_TOKEN" Default="" Description="beste.schule → Benutzerkonto → API → Personal Access Token" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="beste.schule – Kinder" Target="BESTESCHULE_STUDENTS" Default="" Description="Optional: nur diese Vornamen/IDs anzeigen, kommagetrennt" Type="Variable" Display="advanced" Required="false"></Config>
  <Config Name="beste.schule – A/B-Korrektur" Target="BESTESCHULE_WEEK_FIX" Default="" Description="Optional: falsch markierte A/B-Stunden korrigieren, Tag:Fach=Woche, kommagetrennt, z.B. Fr:PH=A" Type="Variable" Display="advanced" Required="false"></Config>

  <Config Name="Müll 1 – Name" Target="WASTE_1_NAME" Default="Restabfall" Type="Variable" Display="always" Required="false">Restabfall</Config>
  <Config Name="Müll 1 – Wochentag" Target="WASTE_1_DAY" Default="Mi" Description="Mo … So" Type="Variable" Display="always" Required="false">Mi</Config>
  <Config Name="Müll 1 – Kalenderwoche" Target="WASTE_1_WEEKS" Default="gerade" Description="gerade / ungerade / jede" Type="Variable" Display="always" Required="false">gerade</Config>
  <Config Name="Müll 1 – Farbe" Target="WASTE_1_COLOR" Default="#8A8F98" Type="Variable" Display="advanced" Required="false">#8A8F98</Config>
  <Config Name="Müll 2 – Name" Target="WASTE_2_NAME" Default="Gelbe Tonne" Type="Variable" Display="always" Required="false">Gelbe Tonne</Config>
  <Config Name="Müll 2 – Wochentag" Target="WASTE_2_DAY" Default="Do" Description="Mo … So" Type="Variable" Display="always" Required="false">Do</Config>
  <Config Name="Müll 2 – Kalenderwoche" Target="WASTE_2_WEEKS" Default="gerade" Description="gerade / ungerade / jede" Type="Variable" Display="always" Required="false">gerade</Config>
  <Config Name="Müll 2 – Farbe" Target="WASTE_2_COLOR" Default="#F2C94C" Type="Variable" Display="advanced" Required="false">#F2C94C</Config>
  <Config Name="Müll 3 – Name" Target="WASTE_3_NAME" Default="Blaue Tonne" Type="Variable" Display="always" Required="false">Blaue Tonne</Config>
  <Config Name="Müll 3 – Wochentag" Target="WASTE_3_DAY" Default="Do" Description="Mo … So" Type="Variable" Display="always" Required="false">Do</Config>
  <Config Name="Müll 3 – Kalenderwoche" Target="WASTE_3_WEEKS" Default="ungerade" Description="gerade / ungerade / jede" Type="Variable" Display="always" Required="false">ungerade</Config>
  <Config Name="Müll 3 – Farbe" Target="WASTE_3_COLOR" Default="#4F8EF7" Type="Variable" Display="advanced" Required="false">#4F8EF7</Config>
  <Config Name="Müll – Feiertagsverschiebung" Target="WASTE_HOLIDAY_SHIFT" Default="on" Description="on = Abholung rutscht nach Feiertagen einen Tag nach hinten, off = nie" Type="Variable" Display="advanced" Required="false">on</Config>

  <Config Name="Bring! – E-Mail" Target="BRING_EMAIL" Default="" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Bring! – Passwort" Target="BRING_PASSWORD" Default="" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Bring! – Liste" Target="BRING_LIST" Default="" Description="Optional: Listenname, sonst Standardliste" Type="Variable" Display="always" Required="false"></Config>

  <Config Name="Essen Kind 1 – Name" Target="VIELFALT_1_NAME" Default="" Description="Titel der Karte, z. B. Lukas" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Essen Kind 1 – Kundennummer" Target="VIELFALT_1_USER" Default="" Description="Login von bestellung.vielfaltmenue.com" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Essen Kind 1 – Passwort" Target="VIELFALT_1_PASSWORD" Default="" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Essen Kind 1 – Farbe" Target="VIELFALT_1_COLOR" Default="#4F8EF7" Type="Variable" Display="advanced" Required="false">#4F8EF7</Config>
  <Config Name="Essen Kind 2 – Name" Target="VIELFALT_2_NAME" Default="" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Essen Kind 2 – Kundennummer" Target="VIELFALT_2_USER" Default="" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Essen Kind 2 – Passwort" Target="VIELFALT_2_PASSWORD" Default="" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Essen Kind 2 – Farbe" Target="VIELFALT_2_COLOR" Default="#F2B53A" Type="Variable" Display="advanced" Required="false">#F2B53A</Config>

  <Config Name="Fotos" Target="/data/pictures" Default="/mnt/user/appdata/familydash/pictures" Mode="ro" Description="Ordner mit JPG/PNG/WebP für die Diashow (kein HEIC)" Type="Path" Display="always" Required="false">/mnt/user/appdata/familydash/pictures</Config>
  <Config Name="Fotos – Anzeigedauer" Target="PHOTOS_INTERVAL" Default="45s" Type="Variable" Display="advanced" Required="false">45s</Config>
  <Config Name="Nacht-Hintergrund" Target="/data/bg.jpeg" Default="/mnt/user/appdata/familydash/bg.jpeg" Mode="ro" Description="Bild hinter der Nachtuhr (Datei muss existieren, sonst legt Docker einen Ordner an – dann Eintrag leeren)" Type="Path" Display="advanced" Required="false"></Config>

  <Config Name="Familienapp – URL" Target="FAMILY_APP_SITE_URL" Default="" Description="HTTP-Actions-URL des Convex-Backends der Familienapp, z. B. https://familybackend-http.matthias.lol. Leer = keine Anbindung" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Familienapp – Ingest-Token" Target="FAMILY_APP_INGEST_TOKEN" Default="" Description="Token für POST /ingest/* (Convex: INGEST_TOKEN). Schickt Woche jedes Kindes und KI-Briefings an die App" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Familienapp – Dashboard-Token" Target="FAMILY_APP_DASHBOARD_TOKEN" Default="" Description="Token für GET /todos (Convex: DASHBOARD_TOKEN). Mit TODOS_SOURCE=auto kommen die To-dos dann aus der App statt aus Things" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="To-do-Quelle" Target="TODOS_SOURCE" Default="auto" Description="auto (App, sobald Dashboard-Token gesetzt, sonst Things), things oder familyapp" Type="Variable" Display="advanced" Required="false">auto</Config>
  <Config Name="Things – E-Mail" Target="THINGS_EMAIL" Default="" Description="Things-Cloud-Login (inoffiziell, nur lesend). Leer = keine To-do-Karte" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Things – Passwort" Target="THINGS_PASSWORD" Default="" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Things – Bereich" Target="THINGS_AREA" Default="Familie" Description="Things-Bereich, dessen Heute-Aufgaben angezeigt werden" Type="Variable" Display="always" Required="false">Familie</Config>

  <Config Name="Uptime Kuma – Status-Page-URL" Target="UPTIME_URL" Default="" Description="z. B. http://192.168.188.127:3001/status/dashboard. Leer = kein Dienst-Status im Footer" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="News – Orte/Suchbegriffe" Target="NEWS_LOCAL" Default="" Description="Google-News-Suchen, kommagetrennt, z. B. Crimmitschau,Landkreis Zwickau. Leer = nur Deutschland-Schlagzeilen" Type="Variable" Display="always" Required="false"></Config>
  <Config Name="Wetterbilder-Ordner" Target="WEATHER_BG_DIR" Default="/data/wetter" Description="klar.jpg, heiter.jpg, bewoelkt.jpg, nebel.jpg, regen.jpg, schnee.jpg, gewitter.jpg, nacht.jpg, standard.jpg (+ optional -nacht). off = nur Farbverläufe" Type="Variable" Display="advanced" Required="false">/data/wetter</Config>
  <Config Name="Uptime Kuma – API-Key" Target="UPTIME_API_KEY" Default="" Description="Optional: für Zertifikats-Warnungen (/metrics)" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Uptime Kuma – Zertifikat warnen ab (Tage)" Target="UPTIME_CERT_WARN_DAYS" Default="14" Type="Variable" Display="advanced" Required="false">14</Config>
  <Config Name="Things – Cache" Target="/data/things" Default="/mnt/user/appdata/familydash/things" Mode="rw" Description="Sync-Cache der things3-CLI (muss nobody:users gehören)" Type="Path" Display="advanced" Required="false">/mnt/user/appdata/familydash/things</Config>

  <Config Name="KI – Gemini API-Key" Target="GEMINI_API_KEY" Default="" Description="KI-Karte: morgens Briefing statt Bring!, abends Ausblick auf morgen über den Fotos. Leer = aus" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="KI – Modell" Target="GEMINI_MODEL" Default="gemini-3.8-flash" Type="Variable" Display="advanced" Required="false">gemini-3.8-flash</Config>
  <Config Name="KI – Backend" Target="GEMINI_BACKEND" Default="auto" Description="auto, gemini (AI Studio) oder vertex (Vertex AI Express)" Type="Variable" Display="advanced" Required="false">auto</Config>
  <Config Name="KI – Denktiefe" Target="GEMINI_THINKING" Default="low" Description="low, medium, high" Type="Variable" Display="advanced" Required="false">low</Config>

  <Config Name="Szene Morgen" Target="SCENE_MORNING" Default="06:45" Description="Schultage Mo–Fr; off = Szene auslassen" Type="Variable" Display="advanced" Required="false">06:45</Config>
  <Config Name="Szene Tag" Target="SCENE_DAY" Default="09:00" Type="Variable" Display="advanced" Required="false">09:00</Config>
  <Config Name="Szene Nachmittag" Target="SCENE_AFTERNOON" Default="14:00" Type="Variable" Display="advanced" Required="false">14:00</Config>
  <Config Name="Szene Abend" Target="SCENE_EVENING" Default="19:00" Type="Variable" Display="advanced" Required="false">19:00</Config>
  <Config Name="Szene Nacht" Target="SCENE_NIGHT" Default="21:30" Type="Variable" Display="advanced" Required="false">21:30</Config>
  <Config Name="Szene Morgen (Wochenende)" Target="SCENE_MORNING_WEEKEND" Default="07:30" Type="Variable" Display="advanced" Required="false">07:30</Config>
  <Config Name="Szene Tag (Wochenende)" Target="SCENE_DAY_WEEKEND" Default="10:00" Type="Variable" Display="advanced" Required="false">10:00</Config>
</Container>
